views:
  - type: table
    name: 再調査
    filters:
      and:
        - or:
            - file.inFolder("Knowledge/Wiki")
            - file.inFolder("Knowledge/Zettel")
        - "!note.review.isEmpty()"
    order:
      - file.name
      - review
      - ai_generated
  - type: table
    name: AI が書いたまま
    filters:
      and:
        - "!note.ai_generated.isEmpty()"
        - '!file.inFolder("Knowledge/Reading")'
    order:
      - file.name
      - ai_generated
      - review
  - type: table
    name: 読書の AI 記録
    filters:
      and:
        - "!note.ai_generated.isEmpty()"
        - file.inFolder("Knowledge/Reading")
    order:
      - file.name
      - ai_generated
