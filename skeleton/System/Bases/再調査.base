views:
  - type: table
    name: あとで見返す
    filters:
      and:
        - file.ext == "md"
        - note.review == true
        - or:
            - file.inFolder("Inbox")
            - file.inFolder("Knowledge")
            - file.inFolder("LifeState")
            - and:
                - file.inFolder("LifeLogs")
                - '!file.inFolder("LifeLogs/Sessions")'
            - file.path == "Home.md"
            - file.path == "README.md"
    order:
      - file.name
      - file.folder
      - review
