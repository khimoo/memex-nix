views:
  - type: table
    name: 取り組み
    filters:
      and:
        - file.inFolder("LifeState/Action")
        - file.ext == "md"
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: いつか
    filters:
      and:
        - file.inFolder("LifeState/Someday")
        - file.ext == "md"
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 記録
    filters:
      and:
        - file.inFolder("LifeLogs/Archive")
        - file.ext == "md"
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
