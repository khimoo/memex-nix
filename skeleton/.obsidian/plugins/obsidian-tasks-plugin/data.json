{
  "presets": {},
  "globalQuery": "path regex matches /^(Action|Dailies|Reviews)\\//",
  "globalFilter": "",
  "removeGlobalFilter": false,
  "taskFormat": "tasksPluginEmoji",
  "setCreatedDate": true,
  "setDoneDate": true,
  "setCancelledDate": true,
  "autoSuggestInEditor": true,
  "autoSuggestMinMatch": 0,
  "autoSuggestMaxItems": 20,
  "provideAccessKeys": true,
  "useFilenameAsScheduledDate": false,
  "filenameAsScheduledDateFormat": "",
  "filenameAsDateFolders": [],
  "recurrenceOnNextLine": false,
  "removeScheduledDateOnRecurrence": false,
  "statusSettings": {
    "coreStatuses": [
      {
        "symbol": " ",
        "name": "やる",
        "nextStatusSymbol": "x",
        "availableAsCommand": true,
        "type": "TODO"
      },
      {
        "symbol": "x",
        "name": "済み",
        "nextStatusSymbol": " ",
        "availableAsCommand": true,
        "type": "DONE"
      }
    ],
    "customStatuses": [
      {
        "symbol": "/",
        "name": "やっている",
        "nextStatusSymbol": "x",
        "availableAsCommand": true,
        "type": "IN_PROGRESS"
      },
      {
        "symbol": "w",
        "name": "待ち",
        "nextStatusSymbol": " ",
        "availableAsCommand": true,
        "type": "ON_HOLD"
      },
      {
        "symbol": "s",
        "name": "いつか",
        "nextStatusSymbol": " ",
        "availableAsCommand": true,
        "type": "ON_HOLD"
      },
      {
        "symbol": "-",
        "name": "やめた",
        "nextStatusSymbol": " ",
        "availableAsCommand": true,
        "type": "CANCELLED"
      }
    ]
  },
  "features": {
    "INTERNAL_TESTING_ENABLED_BY_DEFAULT": true
  },
  "generalSettings": {},
  "headingOpened": {
    "Core Statuses": true,
    "Custom Statuses": true
  },
  "debugSettings": {
    "ignoreSortInstructions": false,
    "showTaskHiddenData": false,
    "recordTimings": false
  },
  "loggingOptions": {
    "minLevels": {
      "": "info",
      "tasks": "info",
      "tasks.Cache": "info",
      "tasks.Events": "info",
      "tasks.File": "info",
      "tasks.Query": "info",
      "tasks.Task": "info"
    }
  }
}
